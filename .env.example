# Copia este archivo como .env y ajusta los valores

# Contraseña para /admin y /player  (¡cámbiala!)
ADMIN_PASSWORD=admin

# Servidor
HOST=0.0.0.0
PORT=8000

# URL pública que se mostrará en el QR (si usas un túnel tipo ngrok/cloudflared).
# Si se deja vacío se usa la IP de la red local.
PUBLIC_URL=

# Límites
MAX_PENDING_PER_GUEST=3
MAX_DURATION_SECONDS=900
MAX_PARALLEL_DOWNLOADS=2
AUDIO_QUALITY=192

# Rutas opcionales si ffmpeg/ffplay no están en el PATH
FFMPEG_LOCATION=
FFPLAY_PATH=ffplay
